# This file is managed by Ansible. Do not edit manually.

[user]
    name = {{ git_user_name }}
    email = {{ git_user_email }}

[core]
    editor = {{ git_editor }}

[init]
    defaultBranch = {{ git_default_branch }}

[pull]
    rebase = true

[merge]
    tool = vscode

[mergetool "vscode"]
    cmd = code --wait $MERGED

[alias]
    st = status
    co = switch
    ci = commit
    br = branch
    lg = log --oneline --graph --all --decorate
